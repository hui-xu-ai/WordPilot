{
  "id": "default",
  "name": "简约机器人",
  "version": "1.0",
  "author": "Xu Hui",
  "size": { "width": 64, "height": 64 },

  "parts": {
    "body": "body.svg",
    "eye_left": "eye.svg",
    "eye_right": "eye.svg"
  },

  "mouths": {
    "idle": "mouth_idle.svg",
    "error": "mouth_error.svg",
    "busy": "mouth_busy.svg",
    "disabled": "mouth_off.svg"
  },

  "layout": {
    "eye_left":  { "x": 19, "y": 25, "w": 11, "h": 11 },
    "eye_right": { "x": 34, "y": 25, "w": 11, "h": 11 },
    "mouth":     { "x": 21, "y": 41, "w": 22, "h": 8 }
  },

  "animation": {
    "blink_interval_ms": 3400,
    "blink_duration_ms": 150,
    "breathe_interval_ms": 2600,
    "breathe_scale": 0.045
  },

  "notes": "SVG 中的 $STATE / $BODY / $ACCENT 为占位符，渲染时按主题令牌替换；$STATE 即桌宠状态色（绿/红/黄/灰）。"
}
