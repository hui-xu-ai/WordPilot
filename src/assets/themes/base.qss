/* WordPilot 全局样式模板（Fluent 风格）
 *
 * 占位符 @token.name 由 ThemeService 用 tokens.<theme>.json 渲染后，
 * 再追加 config/user.qss 作为用户覆盖层。
 *
 * 约定：界面代码里不要再写 setStyleSheet，
 * 需要区分样式时用 setObjectName + 下面对应的选择器；
 * 仅「动态值」（颜色预览、字号预览）允许在代码里设置单条属性。
 */

/* ---------- 基础 ---------- */
QWidget {
    background-color: @color.bg.window;
    color: @color.text.primary;
    font-family: "@font.family";
    font-size: @font.size px;
}
QWidget#contentCard,
QGroupBox {
    background-color: @color.bg.card;
    border: 1px solid @color.border;
    border-radius: @radius.lg px;
}
QGroupBox {
    margin-top: @spacing.md px;
    padding: @spacing.md px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: @spacing.md px;
    padding: 0 @spacing.xs px;
    color: @color.text.secondary;
}

/* ---------- 按钮 ---------- */
QPushButton {
    background-color: @color.bg.card;
    border: 1px solid @color.border.strong;
    border-bottom: 2px solid @color.border.strong;
    border-radius: @radius.md px;
    padding: @spacing.sm px @spacing.lg px;
    min-height: 28px;
    color: @color.text.primary;
}
QPushButton:hover {
    background-color: @color.bg.hover;
}
QPushButton:pressed {
    background-color: @color.bg.disabled;
    border-bottom-width: 1px;
}
QPushButton:disabled {
    color: @color.text.disabled;
    background-color: @color.bg.disabled;
    border-color: @color.border;
}
QPushButton:checked,
QPushButton:flat:checked {
    background-color: @color.accent;
    color: @color.on_accent;
    border-color: @color.accent;
}
QPushButton[accent="true"] {
    background-color: @color.accent;
    color: @color.on_accent;
    border-color: @color.accent;
    font-weight: bold;
}
QPushButton[accent="true"]:hover {
    background-color: @color.accent.hover;
}
QPushButton[accent="true"]:pressed {
    background-color: @color.accent.pressed;
}
/* 导航助手「返回上一位置」主操作按钮 */
QPushButton#navReturnBtn {
    background-color: @color.accent;
    color: @color.on_accent;
    font-weight: bold;
    padding: @spacing.md px;
    border-radius: @radius.md px;
    border: none;
}
QPushButton#navReturnBtn:hover {
    background-color: @color.accent.hover;
}

/* ---------- 输入控件 ---------- */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    background-color: @color.bg.card;
    border: 1px solid @color.border.strong;
    border-radius: @radius.sm px;
    padding: @spacing.sm px;
    selection-background-color: @color.accent;
    selection-color: @color.on_accent;
}
QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border-color: @color.border;
    border-bottom: 2px solid @color.border.focus;
}
/* 数字框的步进按钮：扁平化，去掉系统默认的厚重箭头 */
QSpinBox::up-button,
QDoubleSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button {
    background-color: transparent;
    border: none;
    border-left: 1px solid @color.border;
    width: 20px;
}
QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: @color.bg.hover;
}
/* 关键点：一旦给 QSpinBox 加了全局样式，Qt 就不再绘制系统箭头，
   这里必须显式指定箭头图标，否则步进按钮会变成一片空白 */
QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url("@path.icons/spin-up.svg");
    width: 10px;
    height: 6px;
}
QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url("@path.icons/spin-down.svg");
    width: 10px;
    height: 6px;
}
QLineEdit:read-only,
QTextEdit:read-only,
QPlainTextEdit:read-only {
    background-color: @color.bg.subtle;
    color: @color.text.secondary;
}
QComboBox::drop-down {
    border: none;
    width: 18px;
}
QComboBox QAbstractItemView {
    background-color: @color.bg.card;
    border: 1px solid @color.border;
    selection-background-color: @color.bg.hover;
    selection-color: @color.text.primary;
}

/* ---------- 列表 / 树 / 表格 ---------- */
QListWidget,
QTreeWidget,
QTableWidget {
    background-color: @color.bg.card;
    border: 1px solid @color.border;
    border-radius: @radius.md px;
    alternate-background-color: @color.bg.subtle;
}
QListWidget::item,
QTreeWidget::item {
    padding: @spacing.sm px;
    border-radius: @radius.sm px;
}
QListWidget::item:hover,
QTreeWidget::item:hover {
    background-color: @color.bg.hover;
}
QListWidget::item:selected,
QTreeWidget::item:selected {
    background-color: @color.accent;
    color: @color.on_accent;
}
QHeaderView::section {
    background-color: @color.bg.subtle;
    border: none;
    border-right: 1px solid @color.border;
    border-bottom: 1px solid @color.border;
    padding: @spacing.sm px;
    font-weight: bold;
}

/* ---------- 容器 ---------- */
QTabWidget::pane {
    background-color: @color.bg.card;
    border: 1px solid @color.border;
    border-radius: @radius.md px;
    top: -1px;
}
QTabBar::tab {
    background-color: transparent;
    border: none;
    padding: @spacing.sm px @spacing.md px;
    color: @color.text.secondary;
}
QTabBar::tab:selected {
    color: @color.text.primary;
    border-bottom: 2px solid @color.accent;
    font-weight: bold;
}
QTabBar::tab:hover {
    background-color: @color.bg.hover;
}
QSplitter::handle {
    background-color: @color.border;
}
QProgressBar {
    background-color: @color.bg.subtle;
    border: 1px solid @color.border;
    border-radius: @radius.sm px;
    text-align: center;
    height: 8px;
}
QProgressBar::chunk {
    background-color: @color.accent;
    border-radius: @radius.sm px;
}
QSlider::groove:horizontal {
    background-color: @color.border;
    height: 4px;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background-color: @color.accent;
    border: none;
    width: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::sub-page:horizontal {
    background-color: @color.accent;
    height: 4px;
    border-radius: 2px;
}
QCheckBox,
QRadioButton {
    spacing: @spacing.sm px;
    background-color: transparent;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid @color.border.strong;
    border-radius: @radius.sm px;
    background-color: @color.bg.card;
}
QCheckBox::indicator:hover {
    border-color: @color.accent;
}
QCheckBox::indicator:checked {
    background-color: @color.accent;
    border-color: @color.accent;
    image: url("@path.icons/check.svg");
}
QCheckBox::indicator:disabled {
    background-color: @color.bg.disabled;
    border-color: @color.border;
}
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid @color.border.strong;
    border-radius: 9px;
    background-color: @color.bg.card;
}
QRadioButton::indicator:checked {
    border: 5px solid @color.accent;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle {
    background-color: @color.border.strong;
    border-radius: 5px;
    min-height: 24px;
    min-width: 24px;
}
QScrollBar::handle:hover {
    background-color: @color.text.disabled;
}
QScrollBar::add-line,
QScrollBar::sub-line {
    height: 0;
    width: 0;
}

/* ---------- 菜单 / 状态栏 / 提示 ---------- */
QMenuBar {
    background-color: @color.bg.window;
    border: none;
}
QMenuBar::item:selected {
    background-color: @color.bg.hover;
    border-radius: @radius.sm px;
}
QMenu {
    background-color: @color.bg.card;
    border: 1px solid @color.border;
    border-radius: @radius.md px;
    padding: @spacing.xs px;
}
QMenu::item {
    padding: @spacing.sm px @spacing.lg px;
    border-radius: @radius.sm px;
}
QMenu::item:selected {
    background-color: @color.bg.hover;
    color: @color.text.primary;
}
QMenu::separator {
    height: 1px;
    background-color: @color.border;
    margin: @spacing.xs px @spacing.sm px;
}
QStatusBar {
    background-color: @color.bg.subtle;
    border-top: 1px solid @color.border;
    color: @color.text.secondary;
}
QStatusBar::item {
    border: none;
}
QToolTip {
    background-color: @color.bg.card;
    color: @color.text.primary;
    border: 1px solid @color.border;
    border-radius: @radius.sm px;
    padding: @spacing.xs px @spacing.sm px;
}
QToolButton {
    background-color: transparent;
    border: none;
    border-radius: @radius.sm px;
    padding: @spacing.sm px;
}
QToolButton:hover {
    background-color: @color.bg.hover;
}
QDialog,
QMainWindow {
    background-color: @color.bg.window;
}
QLabel {
    background-color: transparent;
}

/* 工具栏图标按钮（置顶 / 清理） */
QToolButton#toolbarBtn {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: @radius.sm px;
    padding: @spacing.sm px;
}
QToolButton#toolbarBtn:hover {
    background-color: @color.bg.hover;
    border-color: @color.border;
}
QToolButton#toolbarBtn:checked {
    background-color: @color.bg.hover;
    border-color: @color.accent;
}

/* 图标导航轨（极淡分层：只靠底色区分，不画结构分割线） */
QWidget#navRail {
    background-color: @color.bg.rail;
    border: none;
}
QToolButton#navButton,
QToolButton#navAction {
    background-color: transparent;
    border: none;
    border-radius: @radius.md px;
    padding: 9 px 8 px;
    margin: 1 px 6 px;
    color: @color.text.secondary;
    font-size: @font.size px;
    text-align: left;
}
QToolButton#navButton:hover,
QToolButton#navAction:hover {
    background-color: @color.bg.hover;
}
QToolButton#navButton:checked {
    background-color: @color.bg.selected;
    color: @color.text.primary;
    font-weight: bold;
}
QFrame#navDivider {
    background-color: @color.border;
    max-height: 1px;
    min-height: 1px;
    border: none;
    margin: 4 px 10 px;
}
QLabel#dashboardStatus {
    font-size: 20 px;
    font-weight: bold;
}
QLabel#dashboardStatus[state="ok"] { color: @color.state.ok; }
QLabel#dashboardStatus[state="off"] { color: @color.state.off; }
QLabel#sectionTitle {
    color: @color.text.secondary;
    font-weight: bold;
    padding-bottom: @spacing.xs px;
}
QLabel#pluginName {
    color: @color.text.primary;
}

/* ---------- 自绘标题栏（无边框窗口） ---------- */
QWidget#titleBar {
    /* 靠底色区分层级，不加底边分割线（用户要求：极淡过渡，去掉边界线） */
    background-color: @color.bg.titlebar;
    border: none;
}
/* 右侧「次要界面」抽屉（ADR-002）：分隔线用浅色令牌，不要系统默认的深色线 */
QWidget#sidePanelHost {
    border: none;
}
QFrame#sidePanelDivider {
    background-color: @color.border;
    border: none;
    max-width: 1px;
    min-width: 1px;
}
QToolButton#sidePanelToggle {
    background-color: @color.bg.subtle;
    border: none;
    border-left: 1px solid @color.border;
    color: @color.text.secondary;
}
QToolButton#sidePanelToggle:hover {
    background-color: @color.bg.hover;
}
QLabel#titleBarTitle {
    font-weight: bold;
    color: @color.text.primary;
    padding-left: @spacing.xs px;
}
QToolButton#titleBarBtn {
    background-color: transparent;
    border: none;
    border-radius: 0;
    padding: 9 px 14 px;
}
QToolButton#titleBarBtn:hover {
    background-color: @color.bg.hover;
}
QToolButton#titleBarClose:hover {
    background-color: #e81123;
}

/* ---------- 页面骨架：页头 + 卡片 ---------- */
QLabel#pageTitle {
    font-size: 20 px;
    font-weight: bold;
    color: @color.text.primary;
}
QLabel#pageSubtitle {
    color: @color.text.secondary;
    font-size: @font.size.small px;
}
QLabel#cardTitle {
    font-size: 14 px;
    font-weight: bold;
    color: @color.text.primary;
}
/* 页面内的通栏卡片（取代 QGroupBox 的边框标题样式）。
   卡片底色比内容区略深一点，靠色差完成「浅色分区」 */
QWidget#contentCard {
    padding: @spacing.md px;
}

/* 智能纠错页：校对状态指示灯（圆点 + 文字，不再用大号标题表达状态） */
QLabel#proofStatusDot {
    font-size: 12 px;
    background-color: transparent;
}
QLabel#proofStatusDot[state="ok"] { color: @color.state.ok; }
QLabel#proofStatusDot[state="off"] { color: @color.state.off; }
QLabel#proofStatusText {
    font-size: 14 px;
    font-weight: bold;
}
QLabel#proofStatusText[state="ok"] { color: @color.state.ok; }
QLabel#proofStatusText[state="off"] { color: @color.state.off; }

/* ---------- 设置页：左侧子导航 ---------- */
QListWidget#settingsNav {
    background-color: transparent;
    border: none;
    outline: none;
}
QListWidget#settingsNav::item {
    padding: 9 px @spacing.md px;
    border-radius: @radius.md px;
    color: @color.text.secondary;
    margin: 1 px 0;
}
QListWidget#settingsNav::item:hover {
    background-color: @color.bg.hover;
}
QListWidget#settingsNav::item:selected {
    background-color: @color.bg.hover;
    color: @color.accent;
    font-weight: bold;
}

/* ---------- 插件管理：卡片网格 ---------- */
QWidget#pluginCard {
    background-color: @color.bg.card;
    border: 1px solid @color.border;
    border-radius: @radius.lg px;
}
QWidget#pluginCard:hover {
    border-color: @color.border.focus;
}
QLabel#pluginCardName {
    font-size: 14 px;
    font-weight: bold;
    color: @color.text.primary;
}
QLabel#pluginCardBadge {
    color: @color.text.secondary;
    font-size: @font.size.small px;
    border: 1px solid @color.border;
    border-radius: 8px;
    padding: 1 px 8 px;
}
QLabel#pluginCardBadge[state="active"] {
    color: @color.state.ok;
    border-color: @color.state.ok;
}
QLabel#pluginCardBadge[state="failed"] {
    color: @color.state.error;
    border-color: @color.state.error;
}
/* 侧边栏拖动排序的插入指示条 */
QFrame#navDropIndicator {
    background-color: @color.accent;
    border: none;
    max-height: 2px;
    min-height: 2px;
    margin: 0 6px;
}

/* ---------- 校对建议卡片（proofread 插件） ---------- */
QWidget#suggestion_container {
    background: transparent;
    border: none;
}
QWidget#diff_row {
    background-color: @color.bg.card;
    border: 1px solid @color.border;
    border-radius: @radius.md px;
    padding: @spacing.sm px;
}
QWidget#diff_row:hover {
    background-color: @color.bg.hover;
}
QLabel#diffArrow {
    color: @color.text.secondary;
    font-weight: bold;
    border: none;
    background: transparent;
}
QPushButton#petButton {
    background-color: transparent;
    border: none;
    border-radius: 16 px;
    outline: none;
}
QPushButton#petButton:hover {
    background-color: @color.bg.hover;
}
/* 桌宠窗口：本体 + 气泡合并后的单一受管窗口 */
QWidget#petWindow {
    background: transparent;
}
QWidget#petCanvas {
    background: transparent;
}
QMenu#petMenu {
    background-color: @color.bg.card;
    border: 1px solid @color.border;
    border-radius: @radius.md px;
    padding: @spacing.xs px;
}

/* ---------- 语义化标签 ---------- */
QLabel#warningLabel {
    color: @color.warning;
    font-weight: bold;
    margin-bottom: @spacing.sm px;
}
QLabel#hintLabel {
    color: @color.text.secondary;
    font-size: @font.size.small px;
}
QLabel#stateOk { color: @color.state.ok; }
QLabel#stateError { color: @color.state.error; }
QLabel#stateBusy { color: @color.state.busy; }
QLabel#stateOff { color: @color.state.off; }
